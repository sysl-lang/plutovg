// What the binding claims, asserted against the real library.
//
// **These are pixel tests.** A binding can be wrong in a way that compiles, links and returns without
// complaint — a parameter in the wrong order, a float read as a double, an enum off by one — and the
// only thing that catches it is looking at what was drawn. So most of what follows rasterizes
// something small and reads the bytes back.
//
// A surface is premultiplied ARGB32, which on a little-endian machine is the bytes B, G, R, A. The
// helpers below read a pixel out of that.

module sh.sysl.plutovg
@tests

import sh.sysl.plutovg.c
import sysl.fs.{remove_file}

// The four components of the pixel at (x, y).
private blue_at(s: &Surface, x: int, y: int) -> u8 = s.data()[usize(y * s.stride() + x * 4)]
private green_at(s: &Surface, x: int, y: int) -> u8 = s.data()[usize(y * s.stride() + x * 4) + 1]
private red_at(s: &Surface, x: int, y: int) -> u8 = s.data()[usize(y * s.stride() + x * 4) + 2]
private alpha_at(s: &Surface, x: int, y: int) -> u8 = s.data()[usize(y * s.stride() + x * 4) + 3]

// -- surfaces ------------------------------------------------------------------------------------

@test("a surface has the size it was asked for")
surface_has_its_size()
    val s = surface(64, 32).unwrap()

    assert_eq(s.width(), 64)
    assert_eq(s.height(), 32)
end surface_has_its_size

@test("a surface starts fully transparent")
surface_starts_transparent()
    val s = surface(8, 8).unwrap()

    assert_eq(alpha_at(s, 0, 0), 0)
    assert_eq(alpha_at(s, 7, 7), 0)
end surface_starts_transparent

@test("clearing paints every pixel")
clear_paints_everything()
    val s = surface(8, 8).unwrap()

    s.clear(1.0, 0.0, 0.0, 1.0)

    assert_eq(red_at(s, 0, 0), 255)
    assert_eq(green_at(s, 0, 0), 0)
    assert_eq(alpha_at(s, 0, 0), 255)
    assert_eq(red_at(s, 7, 7), 255)
end clear_paints_everything

@test("a surface over the caller's own storage writes into it")
for_data_uses_the_callers_buffer()
    // This is the shape a machine with no room for a full frame uses: the caller owns the pixels and
    // the library never allocates them.
    var pixels: [64]u8

    val s = for_data(pixels[..], 4, 4, 16).unwrap()

    assert_eq(s.width(), 4)
    s.clear(0.0, 0.0, 1.0, 1.0)

    // Blue is the first byte of a little-endian ARGB32 pixel, and it went into the caller's array.
    assert_eq(pixels[0], 255)
    assert_eq(pixels[3], 255)
end for_data_uses_the_callers_buffer

@test("a canvas keeps its surface alive rather than trusting the caller to")
a_canvas_holds_its_surface()
    // The claim the documentation makes about `canvas`, checked against PlutoVG's own count rather
    // than asserted. The absolute number is the library's business and can change, so this is a
    // delta: what the binding is answerable for is the one reference the canvas takes.
    val s = surface(16, 16).unwrap()
    val before = c.surface_get_reference_count(s.handle)

    val cv = canvas(s).unwrap()

    assert_eq(c.surface_get_reference_count(s.handle), before + 1,
              "creating a canvas takes a count on the surface")

    // And it is still usable through the canvas, which is the point of the count.
    cv.rgb(1.0, 1.0, 1.0)
    cv.rect(0.0, 0.0, 16.0, 16.0)
    cv.fill()

    assert_eq(alpha_at(s, 8, 8), 255, "and drawing through it reaches the surface")
end a_canvas_holds_its_surface

// -- filling -------------------------------------------------------------------------------------

@test("a filled rectangle covers what is inside it and nothing outside")
fill_rect_covers_its_own_area()
    val s = surface(32, 32).unwrap()
    val cv = canvas(s).unwrap()

    cv.rgb(0.0, 1.0, 0.0)
    cv.rect(8.0, 8.0, 16.0, 16.0)
    cv.fill()

    assert_eq(green_at(s, 16, 16), 255)
    assert_eq(alpha_at(s, 16, 16), 255)
    assert_eq(alpha_at(s, 2, 2), 0)
    assert_eq(alpha_at(s, 30, 30), 0)
end fill_rect_covers_its_own_area

@test("a colour's components reach the pixel in the right order")
colour_components_are_not_swapped()
    // The failure this catches is a binding that swaps red and blue, which is invisible in greyscale
    // and in any test that only asks whether something was painted.
    val s = surface(4, 4).unwrap()
    val cv = canvas(s).unwrap()

    cv.rgb(1.0, 0.5, 0.0)
    cv.rect(0.0, 0.0, 4.0, 4.0)
    cv.fill()

    assert_eq(red_at(s, 1, 1), 255)
    assert(green_at(s, 1, 1) > 120 && green_at(s, 1, 1) < 136)
    assert_eq(blue_at(s, 1, 1), 0)
end colour_components_are_not_swapped

@test("alpha is premultiplied, as the format says")
alpha_is_premultiplied()
    val s = surface(4, 4).unwrap()
    val cv = canvas(s).unwrap()

    // Half-transparent white over nothing: every component ends at half, not at full.
    cv.rgba(1.0, 1.0, 1.0, 0.5)
    cv.rect(0.0, 0.0, 4.0, 4.0)
    cv.fill()

    assert(red_at(s, 1, 1) > 120 && red_at(s, 1, 1) < 136)
    assert(alpha_at(s, 1, 1) > 120 && alpha_at(s, 1, 1) < 136)
end alpha_is_premultiplied

@test("a circle is round -- painted at its centre and not at its corner")
a_circle_is_round()
    val s = surface(32, 32).unwrap()
    val cv = canvas(s).unwrap()

    cv.rgb(1.0, 1.0, 1.0)
    cv.circle(16.0, 16.0, 12.0)
    cv.fill()

    assert_eq(alpha_at(s, 16, 16), 255)
    assert_eq(alpha_at(s, 1, 1), 0)
end a_circle_is_round

@test("filling clears the path, so a second fill paints nothing")
fill_consumes_the_path()
    val s = surface(16, 16).unwrap()
    val cv = canvas(s).unwrap()

    cv.rect(0.0, 0.0, 16.0, 16.0)
    cv.fill()

    val before = cv.fill_extents()

    assert_eq(before.w, 0.0)
end fill_consumes_the_path

@test("fill_preserve keeps the path for a second use")
fill_preserve_keeps_the_path()
    val s = surface(16, 16).unwrap()
    val cv = canvas(s).unwrap()

    cv.rect(2.0, 2.0, 8.0, 8.0)
    cv.fill_preserve()

    val after = cv.fill_extents()

    assert_eq(after.w, 8.0)
    assert_eq(after.h, 8.0)
end fill_preserve_keeps_the_path

@test("the fill rule decides what an overlap is")
the_fill_rule_decides_an_overlap()
    // Two overlapping rectangles wound the same way, in one path. Under the non-zero rule the
    // overlap is inside; under even-odd it is a hole. This is the test that the enum reaches the
    // library rather than merely type-checking -- a `code()` returning the wrong number paints the
    // wrong picture here and nowhere else in this file.
    val nz = surface(32, 32).unwrap()
    val a = canvas(nz).unwrap()

    a.rgb(1.0, 1.0, 1.0)
    a.fill_rule(FillRule.NonZero)
    a.rect(0.0, 0.0, 20.0, 20.0)
    a.rect(10.0, 10.0, 20.0, 20.0)
    a.fill()

    assert_eq(alpha_at(nz, 15, 15), 255, "non-zero fills the overlap")
    assert_eq(alpha_at(nz, 5, 5), 255, "and the rest of it")

    val eo = surface(32, 32).unwrap()
    val b = canvas(eo).unwrap()

    b.rgb(1.0, 1.0, 1.0)
    b.fill_rule(FillRule.EvenOdd)
    b.rect(0.0, 0.0, 20.0, 20.0)
    b.rect(10.0, 10.0, 20.0, 20.0)
    b.fill()

    assert_eq(alpha_at(eo, 15, 15), 0, "even-odd leaves the overlap empty")
    assert_eq(alpha_at(eo, 5, 5), 255, "and fills what is covered once")
end the_fill_rule_decides_an_overlap

@test("an operator decides how paint combines with what is already there")
an_operator_combines_paint()
    // `Src` replaces rather than composites, so painting transparent black over solid red with it
    // clears the pixel -- which `SrcOver`, the default, would leave alone.
    val s = surface(8, 8).unwrap()
    val cv = canvas(s).unwrap()

    cv.rgba(1.0, 0.0, 0.0, 1.0)
    cv.rect(0.0, 0.0, 8.0, 8.0)
    cv.fill()

    assert_eq(alpha_at(s, 4, 4), 255, "solid red first")

    cv.operator(Operator.Clear)
    cv.rect(0.0, 0.0, 4.0, 4.0)
    cv.fill()

    assert_eq(alpha_at(s, 2, 2), 0, "clear takes the covered part back out")
    assert_eq(alpha_at(s, 6, 6), 255, "and leaves the rest")
end an_operator_combines_paint

// -- geometry ------------------------------------------------------------------------------------

@test("a path's extents are its bounding box")
extents_are_the_bounding_box()
    val s = surface(64, 64).unwrap()
    val cv = canvas(s).unwrap()

    cv.rect(10.0, 20.0, 30.0, 5.0)

    val e = cv.fill_extents()

    assert_eq(e.x, 10.0)
    assert_eq(e.y, 20.0)
    assert_eq(e.w, 30.0)
    assert_eq(e.h, 5.0)
end extents_are_the_bounding_box

@test("a point inside the path is inside it, and one outside is not")
fill_contains_answers_honestly()
    val s = surface(32, 32).unwrap()
    val cv = canvas(s).unwrap()

    cv.circle(16.0, 16.0, 10.0)

    assert(cv.fill_contains(16.0, 16.0))
    assert(!cv.fill_contains(1.0, 1.0))
end fill_contains_answers_honestly

@test("a stroke is wider than the line it follows")
stroke_extents_grow_with_the_width()
    val s = surface(64, 64).unwrap()
    val cv = canvas(s).unwrap()

    cv.line_width(4.0)
    cv.move_to(20.0, 32.0)
    cv.line_to(40.0, 32.0)

    val e = cv.stroke_extents()

    // Two units either side of a horizontal line.
    assert_eq(e.h, 4.0)
end stroke_extents_grow_with_the_width

// -- the transform -------------------------------------------------------------------------------

@test("a translation moves what is drawn")
translate_moves_the_drawing()
    val s = surface(32, 32).unwrap()
    val cv = canvas(s).unwrap()

    cv.translate(16.0, 16.0)
    cv.rgb(1.0, 1.0, 1.0)
    cv.rect(0.0, 0.0, 8.0, 8.0)
    cv.fill()

    // Painted at (20, 20), not at (4, 4).
    assert_eq(alpha_at(s, 20, 20), 255)
    assert_eq(alpha_at(s, 4, 4), 0)
end translate_moves_the_drawing

@test("a scale multiplies what is drawn")
scale_multiplies_the_drawing()
    val s = surface(64, 64).unwrap()
    val cv = canvas(s).unwrap()

    cv.scale(4.0, 4.0)
    cv.rgb(1.0, 1.0, 1.0)
    cv.rect(0.0, 0.0, 8.0, 8.0)
    cv.fill()

    // An eight-unit square at four times the scale reaches 32 pixels.
    assert_eq(alpha_at(s, 30, 30), 255)
    assert_eq(alpha_at(s, 40, 40), 0)
end scale_multiplies_the_drawing

@test("resetting the transform undoes it")
reset_transform_undoes_it()
    val s = surface(32, 32).unwrap()
    val cv = canvas(s).unwrap()

    cv.translate(16.0, 16.0)
    cv.reset_transform()
    cv.rgb(1.0, 1.0, 1.0)
    cv.rect(0.0, 0.0, 8.0, 8.0)
    cv.fill()

    assert_eq(alpha_at(s, 4, 4), 255)
end reset_transform_undoes_it

@test("save and restore put the state back")
save_and_restore_restore_the_state()
    val s = surface(32, 32).unwrap()
    val cv = canvas(s).unwrap()

    cv.save()
    cv.translate(16.0, 16.0)
    cv.restore()

    cv.rgb(1.0, 1.0, 1.0)
    cv.rect(0.0, 0.0, 8.0, 8.0)
    cv.fill()

    assert_eq(alpha_at(s, 4, 4), 255)
end save_and_restore_restore_the_state

// -- clipping ------------------------------------------------------------------------------------

@test("a clip stops paint reaching outside it")
clip_confines_the_paint()
    val s = surface(32, 32).unwrap()
    val cv = canvas(s).unwrap()

    cv.rect(0.0, 0.0, 16.0, 16.0)
    cv.clip()

    cv.rgb(1.0, 1.0, 1.0)
    cv.rect(0.0, 0.0, 32.0, 32.0)
    cv.fill()

    assert_eq(alpha_at(s, 8, 8), 255)
    assert_eq(alpha_at(s, 24, 24), 0)
end clip_confines_the_paint

// -- gradients -----------------------------------------------------------------------------------

@test("a linear gradient runs from one stop to the other")
linear_gradient_runs_between_its_stops()
    val s = surface(64, 8).unwrap()
    val cv = canvas(s).unwrap()
    var stops: [2]Stop = [Stop(0.0, 1.0, 0.0, 0.0, 1.0), Stop(1.0, 0.0, 0.0, 1.0, 1.0)]

    assert(cv.linear_gradient(0.0, 0.0, 64.0, 0.0, stops[..]))
    cv.rect(0.0, 0.0, 64.0, 8.0)
    cv.fill()

    // Red at the left end, blue at the right, and neither at the other's end.
    assert(red_at(s, 1, 4) > 200)
    assert(blue_at(s, 1, 4) < 60)
    assert(blue_at(s, 62, 4) > 200)
    assert(red_at(s, 62, 4) < 60)
end linear_gradient_runs_between_its_stops

@test("a gradient with too many stops is refused rather than truncated")
too_many_stops_is_refused()
    val s = surface(8, 8).unwrap()
    val cv = canvas(s).unwrap()
    var stops: [40]Stop

    assert(!cv.linear_gradient(0.0, 0.0, 8.0, 0.0, stops[..]))
end too_many_stops_is_refused

// -- stroking ------------------------------------------------------------------------------------

@test("a stroke paints along the line and not beside it")
stroke_paints_the_line()
    val s = surface(32, 32).unwrap()
    val cv = canvas(s).unwrap()

    cv.rgb(1.0, 1.0, 1.0)
    cv.line_width(4.0)
    cv.move_to(0.0, 16.0)
    cv.line_to(32.0, 16.0)
    cv.stroke()

    assert_eq(alpha_at(s, 16, 16), 255)
    assert_eq(alpha_at(s, 16, 2), 0)
end stroke_paints_the_line

@test("a round cap paints past the end of the line and a butt cap does not")
a_line_cap_reaches_past_the_end()
    // The other half of the enum check: a cap is a number crossing into C, and the two spellings
    // paint different pixels just past where the line stops.
    val butt = surface(32, 16).unwrap()
    val a = canvas(butt).unwrap()

    a.rgb(1.0, 1.0, 1.0)
    a.line_width(8.0)
    a.line_cap(LineCap.Butt)
    a.move_to(8.0, 8.0)
    a.line_to(20.0, 8.0)
    a.stroke()

    assert_eq(alpha_at(butt, 22, 8), 0, "a butt cap stops where the line does")

    val round = surface(32, 16).unwrap()
    val b = canvas(round).unwrap()

    b.rgb(1.0, 1.0, 1.0)
    b.line_width(8.0)
    b.line_cap(LineCap.Round)
    b.move_to(8.0, 8.0)
    b.line_to(20.0, 8.0)
    b.stroke()

    assert_eq(alpha_at(round, 22, 8), 255, "a round one reaches past it")
end a_line_cap_reaches_past_the_end

@test("a dash pattern leaves gaps")
a_dash_leaves_gaps()
    val s = surface(40, 8).unwrap()
    val cv = canvas(s).unwrap()
    var pattern: [2]f32 = [4.0, 4.0]

    cv.rgb(1.0, 1.0, 1.0)
    cv.line_width(4.0)
    cv.dash(pattern[..])
    cv.move_to(0.0, 4.0)
    cv.line_to(40.0, 4.0)
    cv.stroke()

    // On for four, off for four: something is painted early on and something is not.
    var painted = 0
    var blank = 0

    for x in 0..<40
        if alpha_at(s, x, 4) > 128 then painted += 1 else blank += 1

    assert(painted > 0)
    assert(blank > 0)
end a_dash_leaves_gaps

// -- the enumerations ------------------------------------------------------------------------------

@test("every code is the C compiler's own number, and no two are the same")
enum_codes_are_distinct()
    // What a transcription error looks like: two names with one number. These are asked of the C
    // compiler rather than typed here, so this is checking the `match` arms rather than the values --
    // a copied line naming the wrong constant is exactly what survives review and fails here.
    assert(FillRule.NonZero.code() != FillRule.EvenOdd.code(), "the two fill rules differ")

    val caps = [LineCap.Butt.code(), LineCap.Round.code(), LineCap.Square.code()]

    assert(caps[0] != caps[1] && caps[1] != caps[2] && caps[0] != caps[2], "the three caps differ")

    val joins = [LineJoin.Miter.code(), LineJoin.Round.code(), LineJoin.Bevel.code()]

    assert(joins[0] != joins[1] && joins[1] != joins[2] && joins[0] != joins[2], "and the three joins")

    val spreads = [Spread.Pad.code(), Spread.Reflect.code(), Spread.Repeat.code()]

    assert(spreads[0] != spreads[1] && spreads[1] != spreads[2] && spreads[0] != spreads[2],
           "and the three spread methods")

    // All twelve operators, including the four that were missing before this package asked the
    // header instead of a person.
    val ops = [Operator.Clear.code(), Operator.Src.code(), Operator.Dst.code(),
               Operator.SrcOver.code(), Operator.DstOver.code(), Operator.SrcIn.code(),
               Operator.DstIn.code(), Operator.SrcOut.code(), Operator.DstOut.code(),
               Operator.SrcAtop.code(), Operator.DstAtop.code(), Operator.Xor.code()]

    for i in 0..<ops.len
        for j in 0..<ops.len
            if i != j
                assert(ops[i] != ops[j], "no two operators share a number")
end enum_codes_are_distinct

@test("an enumeration prints as a word rather than a number")
an_enum_prints_as_a_word()
    // The reason these are enums and not `const … : int`: what a program gets from printing one.
    assert_eq(f"${Operator.SrcOver}", "src-over")
    assert_eq(f"${LineCap.Round}", "round")
    assert_eq(f"${LineJoin.Bevel}", "bevel")
    assert_eq(f"${FillRule.EvenOdd}", "even-odd")
    assert_eq(f"${Spread.Reflect}", "reflect")
end an_enum_prints_as_a_word

@test("two enumerations may share a variant name")
round_is_a_cap_and_a_join()
    // `Round` belongs to both, and each resolves by the type it is being used as. This is here
    // because it is the shape that would push somebody into renaming one of them for no reason.
    assert(LineCap.Round.code() >= 0)
    assert(LineJoin.Round.code() >= 0)
    assert_eq(f"${LineCap.Round}", f"${LineJoin.Round}", "and they print the same word")
end round_is_a_cap_and_a_join

// -- fonts ---------------------------------------------------------------------------------------

@test("a font file that is not there answers None rather than a handle to nothing")
a_missing_font_is_none()
    // The ordinary failure rather than an exceptional one, which is why `font` answers an `Option`.
    // The other half of this -- loading a real face -- needs a font file, and this package carries
    // none: it would be a megabyte of somebody else's copyright to assert one number about.
    assert(font("no-such-font-file.ttf").is_none())
    assert(font("/").is_none(), "and a directory is not a font either")
end a_missing_font_is_none

@test("bytes that are not a font answer None too")
bytes_that_are_not_a_font()
    // `font_from_data` is the entry point a machine with no file system uses, and it has to refuse
    // rubbish rather than hand back a face that crashes on the first glyph.
    var notafont: [64]u8 = [0; 64]

    assert(font_from_data(notafont[..]).is_none())
end bytes_that_are_not_a_font

// -- the seam with a panel -------------------------------------------------------------------------

@test("a band rendered into borrowed storage is ARGB32 the panel driver can convert")
a_band_is_argb32()
    // This is the arrangement `sh.sysl.st7796` expects: render a horizontal band into a buffer the
    // caller owns, hand it over, reuse it. A full 320x480 surface at 32bpp is 600 KiB and does not fit
    // on the machine this is for; a 16x4 band is the same shape, small enough to assert about.
    var band: [256]u8

    val s = for_data(band[..], 16, 4, 64).unwrap()
    val cv = canvas(s).unwrap()

    cv.rgb(1.0, 0.0, 0.0)
    cv.rect(0.0, 0.0, 16.0, 4.0)
    cv.fill()

    // B, G, R, A -- red is the third byte, and it is the caller's array that holds it.
    assert_eq(band[0], 0)
    assert_eq(band[1], 0)
    assert_eq(band[2], 255)
    assert_eq(band[3], 255)
end a_band_is_argb32

// -- textures and image files --------------------------------------------------------------------

@test("a texture paints another surface's pixels, cut to the shape that was filled")
a_texture_paints_a_surface()
    val src = surface(4, 4).unwrap()

    src.clear(1.0, 0.0, 0.0)

    val dst = surface(8, 8).unwrap()
    val cv = canvas(dst).unwrap()

    cv.texture(src)
    cv.rect(0.0, 0.0, 4.0, 4.0)
    cv.fill()

    assert_eq(red_at(dst, 1, 1), 255)
    assert_eq(alpha_at(dst, 1, 1), 255)

    // **A texture is a paint source and not a drawing operation**, so what appears is the
    // intersection of the surface and the path -- nothing outside the rectangle that was filled.
    assert_eq(alpha_at(dst, 5, 5), 0)
end a_texture_paints_a_surface

@test("the canvas transform is what places a texture")
a_texture_is_placed_by_the_transform()
    val src = surface(4, 4).unwrap()

    src.clear(0.0, 1.0, 0.0)

    val dst = surface(8, 8).unwrap()
    val cv = canvas(dst).unwrap()

    cv.translate(4.0, 4.0)
    cv.texture(src)
    cv.rect(0.0, 0.0, 4.0, 4.0)
    cv.fill()

    assert_eq(green_at(dst, 5, 5), 255)
    assert_eq(alpha_at(dst, 1, 1), 0, "and nothing was left at the origin")
end a_texture_is_placed_by_the_transform

@test("a tiled texture repeats where a plain one runs out")
tiled_repeats_and_plain_does_not()
    val src = surface(2, 2).unwrap()

    src.clear(0.0, 0.0, 1.0)

    val plain = surface(8, 8).unwrap()
    val tiled = surface(8, 8).unwrap()
    val one = canvas(plain).unwrap()
    val two = canvas(tiled).unwrap()

    one.texture(src, TextureType.Plain)
    one.rect(0.0, 0.0, 8.0, 8.0)
    one.fill()

    two.texture(src, TextureType.Tiled)
    two.rect(0.0, 0.0, 8.0, 8.0)
    two.fill()

    assert_eq(blue_at(plain, 1, 1), 255, "both cover the source's own two pixels")
    assert_eq(blue_at(tiled, 1, 1), 255)
    assert_eq(alpha_at(plain, 5, 5), 0, "and past them a plain texture is nothing")
    assert_eq(blue_at(tiled, 5, 5), 255, "where a tiled one has started again")
end tiled_repeats_and_plain_does_not

@test("an image file that is not there answers None rather than a handle to nothing")
a_missing_image_is_none()
    assert(load_image("no-such-image-file.png").is_none())
    assert(load_image("/").is_none(), "and a directory is not an image either")
end a_missing_image_is_none

@test("bytes that are not an image answer None too")
bytes_that_are_not_an_image()
    var rubbish: [8]u8

    for i in 0..<8 do rubbish[i] = u8(i)

    assert(image_from_data(rubbish[..]).is_none())
    assert(image_from_data(rubbish[0..<0]).is_none(), "and no bytes at all is not an image")
end bytes_that_are_not_an_image

@test("a surface written as a PNG loads back as the same pixels")
a_png_round_trips()
    // **The only test here that touches a file system**, and it is worth the awkwardness: writing and
    // reading are two halves of one claim, and either alone can pass while the pair is wrong -- a
    // decoder that answered a surface of the right size full of nothing would satisfy every other
    // assertion in this file.
    val path = "plutovg-round-trip.png"
    val src = surface(4, 4).unwrap()

    src.clear(1.0, 0.5, 0.0)

    assert(src.write_png(path), "the PNG was written")

    val back = load_image(path).unwrap()

    assert_eq(back.width(), 4)
    assert_eq(back.height(), 4)
    assert_eq(red_at(back, 2, 2), 255)
    assert_eq(alpha_at(back, 2, 2), 255)

    remove_file(path)
end a_png_round_trips
